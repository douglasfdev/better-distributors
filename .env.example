# Modelo de configuração — copie para .env e ajuste (.env não é versionado)
# Valores padrão equivalentes ao comportamento sem arquivo.

# --- API local (gerenciamento no PC) ---
DATABASE_URL=sqlite://distributors.db?mode=rwc
BIND_ADDR=127.0.0.1:3000
FRONTEND_DIST=frontend/dist
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Captura por QR Code (celular) ---
# CAPTURE_PUBLIC_URL exige apenas uma origem: https://host (túnel/produção)
# ou, com CAPTURE_ALLOW_HTTP=1, http://IP-DO-PC:porta para rede local.
# CAPTURE_ALLOW_HTTP=1
# CAPTURE_PUBLIC_URL=
# CAPTURE_BIND_ADDR=127.0.0.1:3001
# CAPTURE_FRONTEND_DIR=frontend
