# Modelo de configuração — copie para .env e ajuste (.env não é versionado)

# --- API local (gerenciamento no PC) ---
DATABASE_URL=
BIND_ADDR=127.0.0.1:3000
FRONTEND_DIST=frontend/dist
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Captura por QR Code (celular) ---
# CAPTURE_PUBLIC_URL exige apenas uma origem: https://host (túnel/produção)
# ou, com CAPTURE_ALLOW_HTTP=1, http://IP-DO-PC:porta para rede local.
# CAPTURE_ALLOW_HTTP=1
# CAPTURE_PUBLIC_URL=
# CAPTURE_BIND_ADDR=127.0.0.1:3001
# CAPTURE_FRONTEND_DIR=frontend

# --- OCR Google Gemini (opcional, opt-in) ---
# OCR_PROVIDER=gemini ativa o OCR remoto somado à chave GEMINI_API_KEY (nunca postada no chat).
# Sem OCR_PROVIDER=gemini ou sem chave válida, o OCR roda apenas no navegador (local).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# OCR_DAILY_LIMIT é estimativo e conta apenas o processo em execução (memória, sem persistência);
# não é garantia de uso gratuito. Se a cota do Google for atingida, o servidor aplica uma espera
# e o OCR volta para o modo local.
# OCR_DAILY_LIMIT=20
